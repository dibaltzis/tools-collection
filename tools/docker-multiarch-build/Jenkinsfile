pipeline {
    agent { label 'fedora-docker' }

    environment {
        REGISTRY = '192.168.31.229:5444' // or 'ghcr.io'
        IMAGE    = 'project-name-placeholder'
        // For GHCR usage
        // GITHUB_USER = 'github-username-placeholder'
        // GHCR_TOKEN → provide via Jenkins credentials (not here)
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Push') {
            steps {
                sh 'chmod +x build-registry.sh'
                sh './build-registry.sh'
            }
        }

        // stage('Build & Push') {
        //     steps {
        //         withCredentials([string(credentialsId: 'ghcr-token', variable: 'GHCR_TOKEN')]) {
        //             sh 'chmod +x build-ghcr.sh'
        //             sh './build-ghcr.sh'
        //         }
        //     }
        // }
    }

    post {
        success {
            script {
                def shortCommit = env.GIT_COMMIT?.take(6) ?: 'unknown'
                echo "✅ Image pushed: ${REGISTRY}/${IMAGE}:${shortCommit}"
            }
        }

        failure {
            echo "❌ Build failed for ${IMAGE}"
        }
    }
}